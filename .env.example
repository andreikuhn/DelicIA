# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o Git.
# No Streamlit Cloud, estes mesmos nomes vão em "Secrets" (veja docs/publicar_site.md).

# Qual LLM usar: ollama (local e gratuito) ou gemini (site; chave gratuita)
LLM_PROVIDER=ollama
# Opcional: outro modelo. Vazio = qwen2.5:7b (Ollama), gemini-3.1-flash-lite (Gemini)
LLM_MODEL=
# Só para LLM_PROVIDER=gemini: chave criada no Google AI Studio
GEMINI_API_KEY=

# Só para o site (app.py): projeto no Supabase, em Project Settings > API
SUPABASE_URL=
# Use a chave "publishable" (ou "anon"). NUNCA a "secret"/"service_role".
SUPABASE_KEY=
