# Modelo dos "Secrets" do site. No computador: copie para .streamlit/secrets.toml (não vai para o Git).
# No Streamlit Cloud: cole este conteúdo, preenchido, em App settings > Secrets.
LLM_PROVIDER = "gemini"
LLM_MODEL = ""          # vazio = gemini-3.1-flash-lite; confira no AI Studio os modelos da sua chave
GEMINI_API_KEY = ""
SUPABASE_URL = ""       # https://<seu-projeto>.supabase.co
SUPABASE_KEY = ""       # chave "publishable" (ou "anon"); nunca a "secret"/"service_role"
